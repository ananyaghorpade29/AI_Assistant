from langchain_google_genai import ChatGoogleGenerativeAI
from langchain_core.tools import tool
from config import GEMINI_MODEL

@tool
def student_database(question:str) -> str:
	"""
	Search the student database for information about students, enrollment, counts, and records.
	"""
	return "There are 18 students enrolled."

model = ChatGoogleGenerativeAI(
	model = GEMINI_MODEL)

model_with_tools = model.bind_tools([student_database])

question = "How many students are enrolled?"

response = model_with_tools.invoke(question)

print("\nTool call:")
print(response.tool_calls)


